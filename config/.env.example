# Google Gemini API 金鑰，用來翻譯文章、解析單字/文法
# 申請：https://aistudio.google.com/apikey （免費，個人低用量通常落在免費額度內）
GEMINI_API_KEY=請貼上你的 Gemini API key

# 用哪個模型做翻譯/解析，預設用 gemini-3.5-flash-lite（免費額度較寬鬆，速度快）
# 想品質更好可以改成 gemini-3.6-flash（免費額度只有每天 20 次，容易超額）
GEMINI_MODEL=gemini-3.5-flash-lite

# 每次排程最多處理幾篇新文章（避免新聞一次湧入時超過免費額度限制）
# 剩下的文章會留到下一次排程繼續處理，不會遺失
MAX_ARTICLES_PER_RUN=8

# 以下只有部署到雲端主機、網頁對外公開時才需要設定（本機/區網用可以留空不設）
WEB_USERNAME=
WEB_PASSWORD=
