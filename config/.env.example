# Claude API 金鑰，用來翻譯文章、解析單字/文法
# 申請：https://console.anthropic.com/ -> Settings -> API Keys
ANTHROPIC_API_KEY=請貼上你的 Claude API key

# 用哪個模型做翻譯/解析，預設用 Sonnet（品質好，成本也還好）
# 想省錢可以改成 claude-haiku-4-5-20251001（速度快、便宜很多，品質稍降）
CLAUDE_MODEL=claude-sonnet-5

# 每次排程最多處理幾篇新文章（避免新聞一次湧入時 API 費用暴衝）
# 剩下的文章會留到下一次排程繼續處理，不會遺失
MAX_ARTICLES_PER_RUN=8

# 以下只有部署到雲端主機、網頁對外公開時才需要設定（本機/區網用可以留空不設）
WEB_USERNAME=
WEB_PASSWORD=
